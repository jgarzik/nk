# NK conformance driver nkc-waitn (waiting on several objects).
#
# One request runs the driver's checks and returns the values it logged,
# 32 bits each, ending with 0x4E4B4321. What each value means is written
# beside it in nk-fixtures nkc/nkc-waitn.c. The second request has a buffer
# too small for the list and must be refused whole.

load nkc-waitn nkc-waitn.sys
open d \Device\NkcWaitN
ioctl d 00222000 - 256
ioctl d 00222000 - 8
close d
unload nkc-waitn
