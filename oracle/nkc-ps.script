# NK conformance driver nkc-ps (the System process and its threads).
#
# The first request returns ids, sessions, attaching to the current
# process, waits and alerts through handles, thread priority through a
# handle and quota; the second, silos. 32 bits each, ending with
# 0x4E4B4321. What each value means is written beside it in nk-fixtures
# nkc/nkc-ps.c.

load nkc-ps nkc-ps.sys
open d \Device\NkcPs
ioctl d 00222000 - 16384
ioctl d 00222004 - 16384
close d
unload nkc-ps
