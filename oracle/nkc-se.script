# NK conformance driver nkc-se (security descriptors).
#
# One request runs the driver's checks and returns the values it logged,
# 32 bits each, ending with 0x4E4B4321. What each value means is written
# beside it in nk-fixtures nkc/nkc-se.c. The second request has a buffer
# too small for the list and must be refused whole.

load nkc-se nkc-se.sys
open d \Device\NkcSe
ioctl d 00222000 - 16384
ioctl d 00222004 - 16384
ioctl d 00222000 - 8
close d
unload nkc-se
