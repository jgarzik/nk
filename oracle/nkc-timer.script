# NK conformance driver nkc-timer (kernel timers).
#
# One request runs the driver's checks and returns the values it logged,
# 32 bits each, ending with 0x4E4B4321. What each value means is written
# beside it in nk-fixtures nkc/nkc-timer.c. The second request has a buffer
# too small for the list and must be refused whole.

load nkc-timer nkc-timer.sys
open d \Device\NkcTimer
ioctl d 00222000 - 256
ioctl d 00222000 - 8
close d
unload nkc-timer
