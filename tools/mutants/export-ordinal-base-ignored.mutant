# An export's ordinal is taken as its place in the address table,
# without the directory's ordinal base: every import from a library
# whose ordinals do not start at zero is bound to another export's
# address, or to none.
scenario: x86_64
fails: oracle.nkc-lib
file: lib/pe/exports.rs
replace:         let slot = ordinal.wrapping_sub(self.base);
with:         let slot = ordinal;
