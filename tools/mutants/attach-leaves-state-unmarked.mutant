# An attach to the thread's own process leaves the caller's saved state
# as it was: the detach that follows reads whatever the stack held and
# takes it for a process to go back to.
scenario: x86_64
fails: ps.attach
file: kernel/ps/process.rs
replace:                 .write_unaligned(core::ptr::without_provenance_mut(KAPC_STATE_NOT_ATTACHED));
with:                 .write_unaligned((&raw const (*apc_state).Process).read_unaligned());
