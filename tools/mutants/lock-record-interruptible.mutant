# The record of locks a processor holds is updated with interrupts on,
# so an interrupt handler that takes a lock can land in the middle of an
# update and corrupt it.
scenario: x86_64
fails: scenario
file: kernel/ke/spinlock.rs
replace:     let saved = arch::interrupts_off();
with:     let saved = arch::interrupts_off(); arch::interrupts_restore(saved);
