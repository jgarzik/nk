# Cancelling an IRP calls the cancel routine but leaves it set: the
# driver's own completion path still thinks the request is its to
# complete, and it is completed twice.
scenario: aarch64
fails: scenario
file: kernel/io/irp.rs
replace:             .swap(core::ptr::null_mut(), Ordering::SeqCst);
with:             .load(Ordering::Acquire);
