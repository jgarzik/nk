# The registry ignores what the namespace left of a path below
# `\Registry`: every absolute name opens the root key.
scenario: aarch64
fails: cm.namespace
file: kernel/cm/mod.rs
replace:         Ok((key.ok_or(STATUS_OBJECT_TYPE_MISMATCH)?, path))
with:         Ok((key.ok_or(STATUS_OBJECT_TYPE_MISMATCH)?, Vec::new()))
