# An open's root handle is referenced as kernel mode's whoever the open
# is for: user mode names a kernel handle as its root and the open is
# resolved from it.
scenario: x86_64
fails: io.open.user-root
file: kernel/ob/mod.rs
replace:         let (root_ref, _) = handle::reference_for(root as u64, None, 0, handle_mode)?;
with:         let (root_ref, _) = handle::reference_for(root as u64, None, 0, nk_ob::handles::Mode::Kernel)?;
