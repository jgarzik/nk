# A wait by handle is never alertable, whatever its caller asks: a
# thread that is alerted to make it stop waiting waits on.
scenario: x86_64
fails: ob.event-handle
file: kernel/ob/event.rs
replace:         wait::wait_as(Some(body.cast()), timeout, KERNEL_MODE, alertable != 0) as NTSTATUS
with:         wait::wait_as(Some(body.cast()), timeout, KERNEL_MODE, false) as NTSTATUS
