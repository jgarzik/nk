# When the oldest waiter of a push lock wants shared access every waiter
# is to be woken; here only that one is, and the readers behind it get
# in one at a time, each when the one before lets go.
scenario: aarch64
fails: ex.pushlock.readers
file: kernel/ex/pushlock.rs
replace:                         Wake::All => true,
with:                         Wake::All => taken.is_null(),
